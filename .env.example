# Control Tower — example environment
#
#     cp .env.example .env
#
# Only what the install needs before its admin is reachable lives here: secrets, the database, the AI key, mail and
# addresses. Every business number (agents' budgets, schedules, limits, texts) is set in the admin.
# .env is gitignored. Keep it that way.

# ---------------------------------------------------------------------------
# The install
# ---------------------------------------------------------------------------
# The company's name: shown in the admin, in e-mails and to the agents.
APP_NAME=Control Tower
# Your time zone (IANA name): agents' schedules, posting hours and the days Insights counts.
TIME_ZONE=UTC
# The public address of this install (the agent gateway's and the media links' origin), e.g. https://tower.example.com
PUBLIC_BASE_URL=
# Only these addresses may open the admin (comma separated; empty: any). The agent gateway and media links stay open.
ADMIN_IP_ALLOWLIST=

# ---------------------------------------------------------------------------
# Secrets — required in production
# ---------------------------------------------------------------------------
# At least 32 random characters: encrypts the admins' authenticator secrets, mailbox passwords and provider keys.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_SECRET=
# The compose PostgreSQL's password.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# AI — Google Gemini (Nia, the agents, pictures, videos)
# ---------------------------------------------------------------------------
# Without a key the admin runs, but no agent and no Nia can think. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
# The install's last safety rail for all AI use, in USD (each agent also has its own budget in the admin).
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=60

# ---------------------------------------------------------------------------
# The install's own mailbox (admin invitations, alerts, the weekly report)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Alerts and the Monday report go here (empty: only the bell in the admin).
ADMIN_ALERT_EMAIL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Your own website, contact address and legal pages, for e-mail footers.
PUBLIC_SITE_URL=
SUPPORT_EMAIL=
PRIVACY_URL=
IMPRINT_URL=
# ClamAV for attached files (docker compose --profile clamav, then CLAMD_HOST=clamav).
CLAMD_HOST=

# ---------------------------------------------------------------------------
# Development only (without docker compose)
# ---------------------------------------------------------------------------
# EXECUTION_MODE=development
# DATABASE_ENGINE=sqlite
